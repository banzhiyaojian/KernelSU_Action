# ============================================================
# Pixel 3 (blueline) / Pixel 3 XL (crosshatch)
# LineageOS 22.2 (Android 15) + KernelSU
# 配套 xiaoleGun/KernelSU_action 使用
# ============================================================

CONFIG_ENV=config/blueline.env

# ================= 内核源码 =================
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_google_msm-4.9
KERNEL_SOURCE_BRANCH=lineage-22.2
KERNEL_CONFIG=b1c1_defconfig
KERNEL_IMAGE_NAME=Image.lz4
ARCH=arm64

KERNEL_NAME=blueline
ADD_LOCALVERSION_TO_FILENAME=false

# ================= 编译工具链 =================
# 4.9 内核必须用旧版 clang，新版会因丢弃的编译选项直接报错
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# 【必须保留】内核 Makefile 里有一句 CLANG_TRIPLE ?= $(CROSS_COMPILE)。
# 上面开了 GCC_ARM64 后 CROSS_COMPILE 是 aarch64-linux-android-，
# 于是 clang 的 --target 变成 android，被 scripts/clang-android.sh 判定
# 为 Android target，直接报 "Did you specify CLANG_TRIPLE?" 停掉。
# 显式指到 GNU target 即可通过这项检查。
#CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
#EXTRA_CMDS:LD=aarch64-linux-android-ld.bfd KCFLAGS=-gdwarf-4
EXTRA_CMDS:KCFLAGS=-gdwarf-4

# ================= KernelSU =================
# resukisu 专为旧内核 / non-GKI 设计，4.9 首选
# 想要官方原版可改成 kernelsu（会自动锁定 v0.9.5，较老）
KSU_VARIANT=resukisu
KSU_REF=
KSU_HOOK_MODE=auto
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ================= SUSFS =================
# 4.9 的 SUSFS 补丁自 2025 年初起没再更新，容易打不上，先不开
ENABLE_SUSFS=false

# ================= 关键补丁 =================
# path_umount 是 Linux 5.9 才引入的，4.9 必须回移，
# 否则 KernelSU 卸载模块挂载会静默失效
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================= Kconfig =================
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=CONFIG_DEBUG_INFO_DWARF4=y

# ================= 打包 =================
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================= Runner =================
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
